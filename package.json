{
  "name": "claude-my-office",
  "version": "0.6.0",
  "description": "A 3D office and multi-agent control center for Claude Code, Codex, OpenCode, Antigravity, and ZCode.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BoyinGlasses/my-station.git"
  },
  "homepage": "https://github.com/BoyinGlasses/my-station#readme",
  "bugs": {
    "url": "https://github.com/BoyinGlasses/my-station/issues"
  },
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "ai-agents",
    "dashboard",
    "office",
    "3d",
    "threejs",
    "codex",
    "developer-tools"
  ],
  "type": "module",
  "bin": {
    "my-office": "bin/cli.mjs",
    "my-station": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "server/",
    "hooks/",
    "src/i18n/",
    "!src/i18n/server.ts",
    "src/shared/",
    "menubar/",
    "vscode-extension/",
    "public/",
    "next.config.mjs",
    ".next/",
    "!.next/cache/",
    "!.next/dev/",
    "!.next/trace",
    "!.next/trace-build",
    "!.next/diagnostics/",
    "!.next/types/",
    "!.next/turbopack/",
    "!.next/**/*.map",
    "!.next/**/*.nft.json"
  ],
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "build": "next build",
    "start": "node -e \"process.env.NODE_ENV='production'; import('./server/index.mjs')\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "clean:test": "node -e \"import('node:fs').then(fs=>{for(const e of fs.readdirSync('.'))if(/^(\\.next-|test-results)/.test(e))fs.rmSync(e,{recursive:true,force:true})})\"",
    "smoke": "node scripts/smoke.mjs",
    "doctor": "node bin/cli.mjs doctor",
    "prepack": "node scripts/prepack.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.12",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.38.0",
    "eslint-config-next": "16.4.6",
    "gifenc": "1.0.3",
    "pngjs": "7.0.0",
    "typescript": "5.9.3"
  }
}
